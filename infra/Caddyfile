{
	admin off
}

:8080 {
	respond /healthz "ok" 200
}

{$VENA_SITE_ADDRESS} {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@api path /api/* /docs /docs/* /redoc /openapi.json
	handle @api {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
