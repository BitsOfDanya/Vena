{
	admin off
}

:8080 {
	respond /healthz "ok" 200
}

{$VENA_SITE_ADDRESS} {
	request_body {
		max_size 260MB
	}
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@api path /api/* /docs /docs/* /redoc /openapi.json
	handle @api {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

# Add this block to the existing edge Caddyfile.
courses.ufranshize.site {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    reverse_proxy ufranshize-courses-app:3000 {
        # One public proxy in front of the application; do not trust a client-supplied IP.
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }
}
