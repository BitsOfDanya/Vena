# For HTTPS: VENA_SITE_ADDRESS=vena.example.com, VENA_PUBLIC_URL=https://vena.example.com
VENA_SITE_ADDRESS=http://5.129.225.86
VENA_PUBLIC_URL=http://5.129.225.86
# Use a random URL-safe password, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=replace-me
VENA_API_KEYS_JSON='{"replace-with-random-admin-key":"admin"}'
VENA_ML_MODE=demo
VENA_ML_REFRESH_SECONDS=3600
# journal mode: seconds between event batches pulled from the API inbox.
VENA_STREAM_POLL_SECONDS=30
# Optional: cut the history to replay a later period of the journal as a stream.
VENA_STREAM_HISTORY_UNTIL=
VENA_DATASET_DIR=/opt/vena/shared/dataset
VENA_TIMEZONE=Europe/Moscow
SMTP_HOST=
SMTP_FROM=
