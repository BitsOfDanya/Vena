VENA_ENVIRONMENT=local
VENA_DEBUG=false
VENA_ML_DIR=../ml
# PostgreSQL 12+ (required). For Docker Compose use host `db` instead of localhost.
VENA_DATABASE_URL=postgresql+psycopg://vena:vena@localhost:5432/vena
VENA_PUBLIC_URL=http://localhost:3100
VENA_TIMEZONE=Europe/Moscow
VENA_SEED_DEMO=true
VENA_DIGEST_ENABLED=true
# Auth. When enabled, send X-API-Key or Bearer token. Docker defaults to enabled with stand keys.
VENA_AUTH_ENABLED=true
# JSON map: api_key -> role OR { "role": "...", "subject": "Display Name" }
VENA_API_KEYS_JSON={"vena-admin":{"role":"admin","subject":"Stand admin"},"vena-dispatch":{"role":"dispatcher","subject":"Duty engineer"},"vena-view":{"role":"viewer","subject":"Viewer"}}

# Spatial demo layer is seeded automatically; replace via PUT /api/v1/spatial with real GeoJSON.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
