VENA_ENVIRONMENT=local
VENA_DEBUG=false
VENA_ML_DIR=../ml
# PostgreSQL 12+ (required). For Docker Compose use host `db` instead of localhost.
VENA_DATABASE_URL=postgresql+psycopg://vena:vena@localhost:5432/vena
VENA_PUBLIC_URL=http://localhost:3100
VENA_TIMEZONE=Europe/Moscow
VENA_SEED_DEMO=true
VENA_DIGEST_ENABLED=true
# Password authentication: generate with openssl rand -hex 32.
VENA_AUTH_ENABLED=true
VENA_JWT_SECRET=replace-with-at-least-32-random-bytes
VENA_JWT_TTL_MINUTES=60
# Explicit opt-in: create user1...user20 once, never reset existing passwords.
VENA_SEED_USERS=false

# Spatial demo layer is seeded automatically; replace via PUT /api/v1/spatial with real GeoJSON.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
