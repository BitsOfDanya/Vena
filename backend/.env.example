VENA_ENVIRONMENT=local
VENA_DEBUG=false
VENA_ML_DIR=../ml
VENA_DATABASE_URL=postgresql+psycopg://vena:vena@localhost:5432/vena
VENA_PUBLIC_URL=http://localhost:3100
VENA_TIMEZONE=Europe/Moscow
VENA_SEED_DEMO=true
VENA_DIGEST_ENABLED=true
VENA_AUTH_ENABLED=true
VENA_JWT_SECRET=replace-with-at-least-32-random-bytes
VENA_JWT_TTL_MINUTES=60
VENA_SEED_USERS=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

VENA_LDAP_ENABLED=false
VENA_LDAP_URL=
VENA_LDAP_BIND_DN=
VENA_LDAP_BIND_PASSWORD=
VENA_LDAP_BASE_DN=
VENA_LDAP_USERNAME_ATTRIBUTE=sAMAccountName
VENA_LDAP_ID_ATTRIBUTE=objectGUID
VENA_LDAP_GROUP_ROLES={}
VENA_LDAP_DEFAULT_ROLE=none
VENA_EQUIPMENT_SYNC_ENABLED=false
VENA_EQUIPMENT_SYNC_URL=
VENA_EQUIPMENT_SYNC_TOKEN=
VENA_EQUIPMENT_SYNC_SOURCE=customer
VENA_EQUIPMENT_SYNC_INTERVAL_SECONDS=900
VENA_EQUIPMENT_SYNC_FIELD_MAP={}
VENA_DATASET_DIR=../ml/dataset
